#__SSL_BLOCK_BEGIN__
server {
    listen 80;
    server_name ${BASE_URL} www.${BASE_URL};
    return 301 https://${BASE_URL}$request_uri;
}
#__SSL_BLOCK_END__

server {
    #__LISTEN__
    server_name ${BASE_URL} www.${BASE_URL};

    client_max_body_size 100M;

    #__SSL_BLOCK_BEGIN__
    ssl_certificate /etc/nginx/ssl/forkeat.crt;
    ssl_certificate_key /etc/nginx/ssl/forkeat.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    #__SSL_BLOCK_END__

    access_log /var/log/nginx/forkeat_access.log;
    error_log /var/log/nginx/forkeat_error.log;

    location / {
        proxy_pass http://api:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ollama/ {
        proxy_pass http://ollama:11434/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- NEO4J SUR /neo4j ---
    location /neo4j {
        # On redirige /neo4j vers /neo4j/ (le slash final est vital)
        rewrite ^/neo4j$ /neo4j/ permanent;
    }

    location /neo4j/ {
        # On retire le préfixe /neo4j/ avant d'envoyer au conteneur
        proxy_pass http://neo4j:7474/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OBLIGATOIRE : Neo4j appelle ces deux routes en dur à la racine
    # Même si tu es sur /neo4j, le JS interne de Neo4j tapera ici
    location /browser {
        proxy_pass http://neo4j:7474/browser;
        proxy_set_header Host $host;
    }

    location /db {
        proxy_pass http://neo4j:7474/db;
        proxy_set_header Host $host;
    }

    # --- TUNNEL BOLT ---
    location /bolt {
        proxy_pass http://neo4j:7687;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;

        # CORRECTIF ICI : On désactive le buffering pour le flux binaire
        proxy_buffering off;
        proxy_request_buffering off;
        tcp_nodelay on;

        # On définit un timeout long pour ne pas couper la connexion DB
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}