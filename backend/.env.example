# --- Projet Docker Compose ---
COMPOSE_PROJECT_NAME=forkeat

# --- Base de données PostgreSQL ---
POSTGRES_URL=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Mettre un mot de passe fort en local
POSTGRES_PASSWORD=
POSTGRES_DB=forkeat_db

# --- Base de données Neo4j ---
NEO4J_BOLT_URL=localhost:7687
NEO4J_USER=neo4j
# Mettre un mot de passe fort en local
NEO4J_PASSWORD=

# --- Stripe ---
STRIPE_API_KEY=...
STRIPE_WEBHOOK_SECRET=...

# --- Base URL de l'application ---
BASE_PROTOCOL=http
BASE_URL=localhost
BASE_PORT=:8080 # mettre le : devant

# --- JWT ---
JWT_SECRET=...

# --- Mot de passe de l'admin par défaut ---
ADMIN_PASSWORD=...

# --- OAuth2 Google ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# --- Mot de passe pour l'envoi de mails ---
MAIL_PASSWORD=...

# --- Cloudflare R2 ---
CLOUDFLARE_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_PUBLIC_URL=...

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11435
